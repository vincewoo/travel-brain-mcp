# Runtime
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
# Latest locations observed within this many minutes are reported as fresh.
LOCATION_FRESHNESS_MINUTES=30

# Protect Host/Origin handling with comma-separated hostnames (no scheme/path/port).
# Fly example: travel-brain-example.fly.dev
ALLOWED_HOSTS=
ALLOWED_ORIGINS=

# Select exactly one authentication mode: static or supabase_oauth.
MCP_AUTH_MODE=static

# Shared Supabase project URL (both modes).
SUPABASE_URL=https://YOUR_PROJECT.supabase.co

# Public browser key used by /oauth/consent in either mode. Never use a secret/service-role key here.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY

# Static mode: interim local/staging single-user deployment.
# Never commit these values. Generate MCP_BEARER_TOKEN with: openssl rand -hex 32
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
TRAVEL_BRAIN_USER_ID=YOUR_SUPABASE_AUTH_USER_UUID
MCP_BEARER_TOKEN=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES

# Supabase OAuth mode: production per-user identity and RLS-scoped access.
# Comment out the static-mode credentials above when switching modes.
# PUBLIC_BASE_URL=https://YOUR_FLY_APP.fly.dev
